# Export these variables in the shell before starting alphaos.
# The application deliberately does not auto-load arbitrary .env files.
ALPHAOS_LLM_BASE_URL=https://your-provider.example/v1
ALPHAOS_LLM_MODEL=your-model-id
ALPHAOS_LLM_API_KEY=your-key

# Optional additional Jev review, only in agent mode; disabled by default.
# Save these fields in the Web settings instead if preferred.
ALPHAOS_JEV_ENABLED=false
ALPHAOS_JEV_BASE_URL=https://api.typesafe.ai/v1
ALPHAOS_JEV_MODEL=jev-1.13.0
ALPHAOS_JEV_API_KEY=
ALPHAOS_JEV_MIN_CONFIDENCE=0.7
# TYPESAFE_API_KEY is a fallback when ALPHAOS_JEV_API_KEY is unset.
